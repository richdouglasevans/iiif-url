{
  "name": "@richdouglasevans/iiif-url",
  "version": "3.0.0",
  "description": "IIIF Image API 3.0.0 URL Parsing",
  "repository": "https://github.com/richdouglasevans/iiif-url",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["./dist/**/*"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": " npm run check && npm run build:ts && npm run test",
    "build:ts": "tsup ./lib/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node --import tsx --test __tests__/*.test.ts",
    "check": "npx @biomejs/biome check --write ./lib",
    "format": "npx @biomejs/biome format --write ./lib",
    "lint": "npx @biomejs/biome lint --write ./lib"
  },
  "keywords": ["iiif"],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.1",
    "cross-env": "^7.0.3",
    "tsup": "8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "@richdouglasevans:registry": "https://npm.pkg.github.com"
  }
}
