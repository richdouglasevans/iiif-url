{
  "name": "iiif-url",
  "version": "3.0.0",
  "description": "IIIF Image API 3.0.0 URL Parsing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "./dist/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:ts && npm run test",
    "build:ts": "tsup ./lib/index.ts --format cjs,esm --dts --clean --sourcemap",
    "format": "npx prettier --loglevel warn --write \"**/*\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest"
  },
  "keywords": [
    "iiif"
  ],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "./jest.preset.cjs"
  }
}
