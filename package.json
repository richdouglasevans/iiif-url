{
  "name": "@richdouglasevans/iiif-url",
  "version": "2.0.0",
  "description": "IIIF Image API 2.0.0 URL Parsing",
  "repository": "https://github.com/richdouglasevans/iiif-url",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "./dist/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": " npm run check && npm run build:ts && npm run test",
    "build:ts": "tsc",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node --import tsx --test __tests__/*.test.ts",
    "check": "biome check --write ./lib",
    "format": "biome format --write ./lib",
    "lint": "biome lint --write ./lib"
  },
  "keywords": [
    "iiif"
  ],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.13.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "@richdouglasevans:registry": "https://npm.pkg.github.com"
  }
}
