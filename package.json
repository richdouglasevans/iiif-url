{
  "name": "@richdouglasevans/iiif-url",
  "version": "2.0.0",
  "description": "IIIF Image API 2.0.0 URL Parsing",
  "repository": "https://github.com/richdouglasevans/iiif-url",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "./dist/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": " npm run check && npm run build:ts && npm run test",
    "build:ts": "tsup ./lib/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node --import tsx --test __tests__/*.test.ts",
    "check": "npx @biomejs/biome check --write ./lib",
    "format": "npx @biomejs/biome format --write ./lib",
    "lint": "npx @biomejs/biome lint --fix ./lib"
  },
  "keywords": [
    "iiif"
  ],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^24.10.9",
    "cross-env": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "@richdouglasevans:registry": "https://npm.pkg.github.com"
  }
}
