{
  "name": "iiif-url",
  "version": "2.0.0",
  "description": "IIIF Image API 2.0.0 URL Parsing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "./dist/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:ts && npm run test",
    "build:ts": "tsup ./lib/index.ts --format cjs,esm --dts --clean --sourcemap",
    "format": "npx prettier --log-level warn --write \"**/*\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node --import tsx --test __tests__/*.test.ts"
  },
  "keywords": [
    "iiif"
  ],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "prettier": "^3.3.3",
    "tsup": "8.3.5",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
