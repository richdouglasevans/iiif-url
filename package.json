{
  "name": "iiif-url",
  "version": "1.0.0",
  "description": "IIIF Image API URL Parsing",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "./dist/**/*.js",
    "./dist/**/*.d.ts"
  ],
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:ts && npm run test",
    "build:ts": "tsc -p .",
    "format": "npx prettier --loglevel warn --write \"**/*\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest"
  },
  "keywords": [
    "iiif"
  ],
  "author": "Rich Douglas",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "./jest.preset.cjs"
  }
}
